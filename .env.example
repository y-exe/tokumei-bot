# TypeScript版。既存Python版の .env とは別に起動設定を確認してください。
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# コマンドをサーバー内だけに登録する場合のID。全サーバーへの登録は --global を指定。
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokumei
# 保存済みWebhookの資格情報を暗号化する32バイト鍵（base64）。
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
MEDIA_CONCURRENCY=2
# Bot管理者のWeb lookupを有効にする専用キー（32文字以上）。未設定なら起動しません。
LOOKUP_ADMIN_TOKEN=
LOOKUP_PORT=8765
