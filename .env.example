# 既存の .env とは別に起動設定を確認してください。
DISCORD_BOT_TOKEN=
# 手動で bun run commands を実行する場合に指定。起動時の自動同期では不要です。
DISCORD_APPLICATION_ID=
# 運営者のDiscordユーザーIDをプレーンテキストで1件返すHTTPS URL。未設定なら運営者権限なし。
BOT_ADMIN_ID_URL=
# 開発用の bun run commands --guild で使うサーバーID。
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokumei
# 保存済みWebhookの資格情報を暗号化する32バイト鍵（base64）。
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
MEDIA_CONCURRENCY=2
# DB接続プールの上限。1〜30、既定5。sharding運用ではこの値×シャード数がDB側の必要接続数になる。
DB_POOL_MAX=5
# sharding運用のシャード数。「auto」または1〜32。未設定なら単一プロセスで起動する。
DISCORD_SHARDS=
# Botがサーバーから離脱した後の設定・投稿データの保持日数。1〜365、既定30。
GUILD_DELETE_GRACE_DAYS=30
# Dockerでは設定済みです。手動起動ではgallery-dlを導入したPythonのパスを指定します。
GALLERY_DL_PYTHON=
# Pixivのログインが必要な作品を取得する場合のセッションCookie。値だけを設定します。
PIXIV_PHPSESSID=
# Tailscale ServeのHTTPS接続先と許可するログイン名（カンマ区切り）。接続先未設定ならlookupを起動しません。
LOOKUP_TAILSCALE_ORIGIN=
LOOKUP_ALLOWED_TAILSCALE_LOGINS=
LOOKUP_PORT=8765
