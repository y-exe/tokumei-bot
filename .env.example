# 既存の .env とは別に起動設定を確認してください。
DISCORD_BOT_TOKEN=
# 手動で bun run commands を実行する場合に指定。起動時の自動同期では不要です。
DISCORD_APPLICATION_ID=
# 開発用の bun run commands --guild で使うサーバーID。
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokumei
# 保存済みWebhookの資格情報を暗号化する32バイト鍵（base64）。
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
MEDIA_CONCURRENCY=2
# Pixivのログインが必要な作品を取得する場合のセッションCookie。値だけを設定します。
PIXIV_PHPSESSID=
# Tailscale ServeのHTTPS接続先と許可するログイン名（カンマ区切り）。接続先未設定ならlookupを起動しません。
LOOKUP_TAILSCALE_ORIGIN=
LOOKUP_ALLOWED_TAILSCALE_LOGINS=
LOOKUP_PORT=8765
